ENVIRONMENT=production

# Backend and Frontend URLs (Production Only)
BACKEND_URL=https://YOUR-RENDER-BACKEND.onrender.com
FRONTEND_URL=https://YOUR-VERCEL-FRONTEND.vercel.app

# Cross-Origin allowed domains (No wildcard * in production)
CORS_PRODUCTION_ORIGINS=https://YOUR-VERCEL-FRONTEND.vercel.app

# API Keys (Must be configured in your deployment platform securely)
URLHAUS_AUTH_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal integration is optional and disabled by default
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=

# Frontend specific URL mappings
NEXT_PUBLIC_API_URL=https://YOUR-RENDER-BACKEND.onrender.com
