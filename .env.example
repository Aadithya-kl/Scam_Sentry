# ScamSentry AI Production Environment Configuration
# DO NOT include real API keys in version control.

# ==========================================
# 1. CORE APPLICATION SETTINGS
# ==========================================
# Defines the operating environment (development / production)
ENVIRONMENT=production

# The external URL where the FastAPI backend is hosted. 
# Used by the extension and frontend.
BACKEND_URL=https://api.scamsentry.com

# The external URL where the Next.js dashboard is hosted.
FRONTEND_URL=https://scamsentry.com

# ==========================================
# 2. SECURITY & CORS
# ==========================================
# A comma-separated list of origins permitted to access the API.
# Use strict origins for production (e.g., https://scamsentry.com,chrome-extension://<your-ext-id>)
# Use "*" strictly for local development extensions only.
CORS_PRODUCTION_ORIGINS=https://scamsentry.com

# ==========================================
# 3. THREAT INTELLIGENCE APIS
# ==========================================

# URLhaus Auth-Key (Required for full coverage)
# Get a key at https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY=your_urlhaus_api_key_here

# Google Safe Browsing API Key (Required)
# Get a key from Google Cloud Console
GOOGLE_SAFE_BROWSING_API_KEY=your_gsb_api_key_here

# VirusTotal API (Optional)
# Rate limits are strict on the free tier, keep disabled unless needed.
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# OpenPhish is handled via a background memory cache, no API key required for community feed.

# ==========================================
# 4. TESTING & DEBUG
# ==========================================
# Enable mocked threat intelligence for demo urls (demo-safe.com, demo-scam.com)
# Ignored when ENVIRONMENT=production.
DEMO_MODE=false
