FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    PORT=8000

# All dependencies ship manylinux wheels for 3.11, so no compiler toolchain is needed.
COPY requirements.txt .
RUN pip install -r requirements.txt

# Application code + trained model artifact (ml/artifacts/scamsentry_model.joblib).
COPY backend/ ./backend/
COPY ml/ ./ml/

RUN adduser --disabled-password --gecos '' appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Liveness check for plain Docker / compose (Render uses healthCheckPath instead).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\",\"8000\")}/health', timeout=4)" || exit 1

# Shell form so $PORT (injected by Render/Railway/Cloud Run) is honoured. Secrets are runtime env only.
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
