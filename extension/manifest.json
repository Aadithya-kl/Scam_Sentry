{
  "manifest_version": 3,
  "name": "ScamSentry AI",
  "version": "1.0.0",
  "description": "Scan pages and links for scams and threats using ScamSentry AI.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  }
}
