# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# --- ML ---
# Raw/processed datasets and plots are reproducible via `python -m ml.download_data && python -m ml.prepare_data && python -m ml.train`.
ml/data/raw/
ml/data/processed/
ml/plots/*.png
# The trained model (~180 KB) IS committed: the Docker/Render build copies it into the image.
# Ignore any other large joblib experiments.
ml/artifacts/*.joblib
!ml/artifacts/scamsentry_model.joblib

# --- Frontend ---
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/.env.*.local

# --- Extension ---
extension/node_modules/
# Generated by `node build.js`; the API URL is baked in per environment, so never commit a build.
extension/popup.js
extension/background.js
extension/styles.css
extension/*.zip

# --- Env files (only the *.example templates are committed) ---
.env
.env.*
!.env.example
!.env.production.example

# --- Logs / local output ---
*.log
pytest_out.txt
test_out.log
.DS_Store
